const jwt = require('jsonwebtoken');
const User = require('../models/User');

const authRequired = async (req, res, next) => {
  // Expect Authorization: Bearer <token>
  const header = req.headers.authorization;
  if (!header) return res.status(401).json({ message: 'No authorization header' });
  const token = header.split(' ')[1];
  try {
    const payload = jwt.verify(token, process.env.JWT_SECRET);
    const user = await User.findById(payload.id).select('-passwordHash');
    if (!user) return res.status(401).json({ message: 'Invalid token' });
    req.user = user;
    next();
  } catch (err) {
    return res.status(401).json({ message: 'Invalid token' });
  }
};

const requireCreator = (req, res, next) => {
  if (!req.user) return res.status(401).json({ message: 'Not authenticated' });
  if (req.user.role !== 'creator' && req.user.role !== 'admin') {
    return res.status(403).json({ message: 'Creator role required' });
  }
  next();
};

module.exports = { authRequired, requireCreator };
const express = require('express');
const Story = require('../models/Story');
const { authRequired, requireCreator } = require('../middleware/auth');
const router = express.Router();

// GET /api/stories - list with basic pagination
router.get('/', async (req, res) => {
  const page = Math.max(1, parseInt(req.query.page || '1'));
  const limit = Math.min(50, parseInt(req.query.limit || '10'));
  const skip = (page - 1) * limit;
  const stories = await Story.find({ published: true }).sort({ createdAt: -1 }).skip(skip).limit(limit).populate('creatorId', 'username');
  res.json({ data: stories });
});

// GET /api/stories/:id
router.get('/:id', async (req, res) => {
  const story = await Story.findById(req.params.id).populate('creatorId', 'username');
  if (!story) return res.status(404).json({ message: 'Not found' });
  res.json(story);
});

// POST /api/stories - create story (creator only)
router.post('/', authRequired, requireCreator, async (req, res) => {
  const { title, description, audioUrl, durationSec, tags } = req.body;
  const story = new Story({
    title, description, audioUrl, durationSec,
    creatorId: req.user._id,
    tags
  });
  await story.save();
  res.status(201).json(story);
});

// POST /api/stories/:id/like - toggle like
router.post('/:id/like', authRequired, async (req, res) => {
  const story = await Story.findById(req.params.id);
  if (!story) return res.status(404).json({ message: 'Not found' });
  const userId = req.user._id;
  const idx = story.likes.findIndex(id => id.equals(userId));
  if (idx === -1) {
    story.likes.push(userId);
  } else {
    story.likes.splice(idx, 1);
  }
  await story.save();
  res.json({ likesCount: story.likes.length, liked: idx === -1 });
});

// POST /api/stories/:id/comment
router.post('/:id/comment', authRequired, async (req, res) => {
  const { text } = req.body;
  if (!text || !text.trim()) return res.status(400).json({ message: 'Comment text required' });
  const story = await Story.findById(req.params.id);
  if (!story) return res.status(404).json({ message: 'Not found' });
  story.comments.push({ userId: req.user._id, username: req.user.username, text });
  await story.save();
  res.status(201).json({ comments: story.comments });
});

module.exports = router;
const express = require('express');
const User = require('../models/User');
const { authRequired } = require('../middleware/auth');
const router = express.Router();

// POST /api/creators/apply
// body: { bio, samples: [url1, url2] }
router.post('/apply', authRequired, async (req, res) => {
  const { bio, samples } = req.body;
  const user = await User.findById(req.user._id);
  if (!user) return res.status(404).json({ message: 'User not found' });

  // If already creator or pending
  if (user.role === 'creator') return res.status(400).json({ message: 'Already a creator' });
  if (user.creatorApplication && user.creatorApplication.status === 'pending') {
    return res.status(400).json({ message: 'Application pending' });
  }

  user.creatorApplication = { bio, samples, status: 'pending', appliedAt: new Date() };
  await user.save();

  // TODO: notify admins for review (email, dashboard)
  res.status(201).json({ message: 'Application submitted', application: user.creatorApplication });
});

