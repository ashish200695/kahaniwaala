const express = require('express');
const AWS = require('aws-sdk');
const { authRequired, requireCreator } = require('../middleware/auth');
const router = express.Router();

AWS.config.update({ region: process.env.AWS_REGION });

const s3 = new AWS.S3();

// POST /api/uploads/presign
// body: { filename, contentType }
// returns { url, key, uploadUrl }
router.post('/presign', authRequired, requireCreator, async (req, res) => {
  const { filename, contentType } = req.body;
  if (!filename || !contentType) return res.status(400).json({ message: 'filename and contentType required' });

  const key = `stories/${req.user._id}/${Date.now()}-${filename}`;
  const params = {
    Bucket: process.env.S3_BUCKET,
    Key: key,
    Expires: 60 * 5,
    ContentType: contentType,
    ACL: 'public-read' // consider private + CloudFront if needed
  };

  try {
    const uploadUrl = await s3.getSignedUrlPromise('putObject', params);
    const publicUrl = `https://${process.env.S3_BUCKET}.s3.${process.env.AWS_REGION}.amazonaws.com/${encodeURIComponent(key)}`;
    res.json({ uploadUrl, key, publicUrl });
  } catch (err) {
    console.error('Presign error', err);
    res.status(500).json({ message: 'Failed to get presigned url' });
  }
});

module.exports = router;
