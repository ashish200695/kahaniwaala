rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Stories - public read, creation allowed only by creators (or allow create with status pending)
    match /stories/{storyId} {
      allow read: if true;

      // create: user must be authenticated and must claim to be creator
      allow create: if request.auth != null
                    && request.auth.token.creator == true
                    && request.resource.data.creatorId == request.auth.uid;

      // update/delete: only creator or admin
      allow update, delete: if request.auth != null
                            && (request.auth.uid == resource.data.creatorId || request.auth.token.admin == true);
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorId || request.auth.token.admin == true);
    }

    // Likes
    match /likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Creator applications
    match /creatorApplications/{appId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && (request.auth.token.admin == true || request.auth.uid == resource.data.userId);
      allow update: if request.auth != null && request.auth.token.admin == true;
    }

    // Reports
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for story audio (or tighten if you want private)
    match /stories/{creatorId}/{storyId}/{fileName} {
      allow read: if true;

      // Only the authenticated creator (owner) can upload to their story path
      allow write: if request.auth != null
                   && request.auth.uid == creatorId
                   && request.auth.token.creator == true;
    }

    // Allow uploads for creator application samples under creatorApplications/
    match /creatorApplications/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other writes
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
// Cloud Function: onFinalize -> publish a Pub/Sub message for a worker to transcode/process.
// This function marks the story document status to 'processing' and publishes metadata.
const functions = require('firebase-functions');
const admin = require('firebase-admin');
const {PubSub} = require('@google-cloud/pubsub');

admin.initializeApp();
const db = admin.firestore();
const pubsub = new PubSub();

exports.onAudioUpload = functions.storage.object().onFinalize(async (object) => {
  try {
    const filePath = object.name; // e.g., "stories/{uid}/{storyId}/original.mp3"
    if (!filePath) return null;

    // Only process files in stories/*/*/original.*
    const parts = filePath.split('/');
    if (parts.length < 4 || parts[0] !== 'stories') return null;

    const creatorId = parts[1];
    const storyId = parts[2];
    const filename = parts.slice(3).join('/');

    // Update Firestore story status to processing (best effort)
    const storyRef = db.collection('stories').doc(storyId);
    await storyRef.set({
      processing: true,
      processingStartedAt: admin.firestore.FieldValue.serverTimestamp(),
      storagePath: filePath
    }, {merge: true});

    // Publish message for Cloud Run worker to pick up (transcoding job)
    const topicName = 'audio-processing';
    const message = {
      storyId,
      creatorId,
      storagePath: filePath,
      bucket: object.bucket,
      contentType: object.contentType,
      size: object.size
    };

    const dataBuffer = Buffer.from(JSON.stringify(message));
    await pubsub.topic(topicName).publish(dataBuffer);

    console.log('Published processing message for', filePath);
    return null;
  } catch (err) {
    console.error('onAudioUpload error', err);
    return null;
  }
});
// Simple admin function you can run locally to set a custom claim (e.g., make user a creator).
// Usage: node setCustomClaim.js <uid> creator true
const admin = require('firebase-admin');
admin.initializeApp();

async function setClaim(uid, claimKey, claimValue) {
  const claims = {};
  claims[claimKey] = (claimValue === 'true' || claimValue === true);
  await admin.auth().setCustomUserClaims(uid, claims);
  console.log(`Set ${claimKey}=${claimValue} for ${uid}`);
}

if (require.main === module) {
  const [,, uid, claimKey, claimValue] = process.argv;
  if (!uid || !claimKey) {
    console.error('Usage: node setCustomClaim.js <uid> <claimKey> <claimValue>');
    process.exit(1);
  }
  setClaim(uid, claimKey, claimValue).catch(e => console.error(e));
}
// Firebase v9 modular SDK example: create story doc, upload audio, update doc.
// (This is a simplified client-side snippet you can adapt)
import { getAuth } from "firebase/auth";
import { getFirestore, doc, setDoc, updateDoc, serverTimestamp } from "firebase/firestore";
import { getStorage, ref, uploadBytesResumable, getDownloadURL } from "firebase/storage";
import { v4 as uuidv4 } from "uuid";

const auth = getAuth();
const db = getFirestore();
const storage = getStorage();

export async function uploadStory({title, description, file, coverFile, tags = []}) {
  const user = auth.currentUser;
  if (!user) throw new Error('Not authenticated');

  // 1) create story doc with status draft/processing
  const storyId = uuidv4();
  const storyRef = doc(db, 'stories', storyId);
  await setDoc(storyRef, {
    title,
    description,
    creatorId: user.uid,
    status: 'draft',
    createdAt: serverTimestamp(),
    tags
  });

  // 2) upload files to storage under stories/{uid}/{storyId}/original.ext
  const ext = file.name.split('.').pop();
  const audioPath = `stories/${user.uid}/${storyId}/original.${ext}`;
  const audioRef = ref(storage, audioPath);
  const uploadTask = uploadBytesResumable(audioRef, file);

  // Optionally upload cover image
  let coverUrl = null;
  if (coverFile) {
    const coverRef = ref(storage, `stories/${user.uid}/${storyId}/cover_${coverFile.name}`);
    await uploadBytesResumable(coverRef, coverFile);
    coverUrl = await getDownloadURL(coverRef);
  }

  // track upload
  await new Promise((resolve, reject) => {
    uploadTask.on('state_changed', 
      snapshot => {
        // progress handler (update UI)
      },
      err => reject(err),
      async () => {
        // Upload complete
        const storageUrl = await getDownloadURL(audioRef);
        // Update story doc; server-side processing will change status to published later
        await updateDoc(storyRef, {
          audioPath,
          audioUrl: storageUrl,
          status: 'uploaded',
          coverUrl: coverUrl || null,
          uploadedAt: serverTimestamp()
        });
        resolve();
      }
    );
  });

  return storyId;
}
