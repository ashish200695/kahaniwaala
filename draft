import React, { useState } from 'react';
import axios from 'axios';

// Props: onUploaded(storyMeta)
export default function UploadStory({ apiBase = '/api' , onUploaded }) {
  const [file, setFile] = useState(null);
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (!file) return alert('Select audio file');
    setLoading(true);
    try {
      // 1. Get presigned URL
      const token = localStorage.getItem('token'); // adapt to your auth
      const res = await axios.post(`${apiBase}/uploads/presign`, {
        filename: file.name,
        contentType: file.type
      }, { headers: { Authorization: `Bearer ${token}` } });
      const { uploadUrl, publicUrl } = res.data;

      // 2. Upload directly to S3
      await axios.put(uploadUrl, file, { headers: { 'Content-Type': file.type } });

      // 3. Create story metadata in backend
      const createRes = await axios.post(`${apiBase}/stories`, {
        title, description, audioUrl: publicUrl, durationSec: 0, tags: []
      }, { headers: { Authorization: `Bearer ${token}` } });

      setFile(null);
      setTitle('');
      setDescription('');
      onUploaded && onUploaded(createRes.data);
      alert('Uploaded and story created');
    } catch (err) {
      console.error(err);
      alert('Upload failed');
    } finally {
      setLoading(false);
    }
  };

  return (
    <form onSubmit={handleSubmit}>
      <h3>Upload a story (creators only)</h3>
      <input required value={title} onChange={e => setTitle(e.target.value)} placeholder="Title" />
      <textarea value={description} onChange={e => setDescription(e.target.value)} placeholder="Description" />
      <input accept="audio/*" type="file" onChange={e => setFile(e.target.files[0])} />
      <button type="submit" disabled={loading}>{loading ? 'Uploading...' : 'Upload'}</button>
    </form>
  );
}
import React, { useState } from 'react';
import axios from 'axios';

export default function CreatorApplyButton({ apiBase = '/api' }) {
  const [open, setOpen] = useState(false);
  const [bio, setBio] = useState('');
  const [samples, setSamples] = useState('');

  const submit = async () => {
    const token = localStorage.getItem('token');
    try {
      const res = await axios.post(`${apiBase}/creators/apply`, {
        bio,
        samples: samples.split(',').map(s => s.trim()).filter(Boolean)
      }, { headers: { Authorization: `Bearer ${token}` } });
      alert('Application submitted');
      setOpen(false);
    } catch (err) {
      console.error(err);
      alert('Failed to submit application');
    }
  };

  return (
    <div>
      <button onClick={() => setOpen(true)}>Apply to be a Creator</button>
      {open && (
        <div className="modal">
          <h3>Creator Application</h3>
          <textarea value={bio} onChange={e => setBio(e.target.value)} placeholder="Tell us about your work" />
          <input value={samples} onChange={e => setSamples(e.target.value)} placeholder="Sample audio URLs, comma-separated" />
          <button onClick={submit}>Submit Application</button>
          <button onClick={() => setOpen(false)}>Cancel</button>
        </div>
      )}
    </div>
  );
}
